# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Unsplash Live Wallpapers (optional). If invalid, app uses Wikimedia live search then CDN.
VITE_UNSPLASH_ACCESS_KEY=

# RevenueCat In-App Purchases (Public SDK Keys)
VITE_REVENUECAT_API_KEY=
VITE_REVENUECAT_WEB_KEY=
VITE_REVENUECAT_APPLE_KEY=
VITE_REVENUECAT_GOOGLE_KEY=

# Production Express API (native + web builds).
VITE_API_BASE_URL=https://oblivion-1-fitness.onrender.com

# Optional. USDA FoodData Central — merged into US live search when set.
# Signup: https://fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=

# Stripe (server / webhooks — never commit live secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
