{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/lock-guard.mjs",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/lock-guard.mjs",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
