{
	"appId": "com.o1fc.fitness",
	"appName": "Oblivion 1",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"backgroundColor": "#000000",
	"ios": {
		"contentInset": "always",
		"backgroundColor": "#000000"
	},
	"android": {
		"backgroundColor": "#000000"
	},
	"plugins": {
		"SystemBars": {
			"style": "DARK",
			"insetsHandling": "css"
		},
		"SplashScreen": {
			"launchShowDuration": 1200,
			"launchAutoHide": true,
			"backgroundColor": "#09090b"
		},
		"SocialLogin": {
			"providers": {
				"google": true,
				"apple": true,
				"facebook": false,
				"twitter": false
			}
		}
	},
	"packageClassList": [
		"BluetoothLe",
		"AppPlugin",
		"CAPBrowserPlugin",
		"CAPCameraPlugin",
		"FilesystemPlugin",
		"GeolocationPlugin",
		"LocalNotificationsPlugin",
		"PreferencesPlugin",
		"SharePlugin",
		"SocialLoginPlugin",
		"PurchasesPlugin"
	]
}
