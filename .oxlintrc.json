{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "ignorePatterns": [
    "android/**",
    "ios/**",
    "dist/**",
    "src/features/log/**",
    "src/features/radar/**",
    "src/stores/useLogStore.ts",
    "src/stores/useRadarStore.ts",
    "src/stores/radarTypes.ts",
    "src/stores/useBuddyProfileStore.ts",
    "src/stores/useBuddyMessageStore.ts",
    "src/services/buddyPresenceSync.ts"
  ]
}
