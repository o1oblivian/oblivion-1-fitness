.gcloudignore
.git/
.gitignore

# Package and build artifacts (Cloud Run buildpacks build fresh)
node_modules/
dist/
dist-ssr/
bun.lock

# Mobile platform native projects (used by Codemagic/Capacitor, not Cloud Run web server)
android/
ios/

# Large media assets not required for web server execution
public/videos/
public/appstore_ipad/
public/appstore_screenshots/
public/ipad_*.png
public/screenshot_*.png

# Transient test and automation scripts
record_*.cjs
capture_*.cjs
compile_*.cjs
inspect_dom.cjs
test_*.cjs
scripts_generate_reels.py

# Editor and log artifacts
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
